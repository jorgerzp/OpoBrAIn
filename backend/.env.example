PORT=5000
# Cadena de conexión de Neon PostgreSQL (incluye ?sslmode=require)
DATABASE_URL=postgres://usuario:password@ep-sample-project-123456.eu-central-1.aws.neon.tech/opobrain?sslmode=require
NODE_ENV=development

# Configuración de OpenRouter para extracción inteligente de exámenes en PDF
OPENROUTER_API_KEY=sk-or-v1-tu-clave-de-openrouter-aqui
# Modelos sugeridos: google/gemini-2.5-flash (muy rápido, económico y ventana de contexto de 1M tokens) o openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-2.5-flash
