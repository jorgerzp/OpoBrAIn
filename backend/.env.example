PORT=5000
# Cadena de conexión de Neon PostgreSQL (incluye ?sslmode=require)
DATABASE_URL=postgres://usuario:password@ep-sample-project-123456.eu-central-1.aws.neon.tech/opobrain?sslmode=require
NODE_ENV=development

# Configuración de OpenRouter para generación de tests con IA y extracción de PDFs
OPENROUTER_API_KEY=sk-or-v1-tu-clave-de-openrouter-aqui
# Modelo gratuito recomendado: meta-llama/llama-3-8b-instruct:free (o meta-llama/llama-3.1-8b-instruct:free)
OPENROUTER_MODEL=meta-llama/llama-3-8b-instruct:free
# URL de la aplicación para cabecera HTTP-Referer de OpenRouter
SITE_URL=http://localhost:5173
